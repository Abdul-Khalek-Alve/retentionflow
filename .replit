modules = ["python-3.11"]
run = "pip install -q -r requirements.txt && uvicorn app:app --host 0.0.0.0 --port 8000"

[[ports]]
localPort = 8000
externalPort = 80

# Choose the deployment type (Autoscale or Reserved VM) in Replit's Publish screen;
# Replit adds the matching deploymentTarget line here automatically.
[deployment]
build = ["sh", "-c", "pip install -r requirements.txt && python train.py"]
run = ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port 8000"]
